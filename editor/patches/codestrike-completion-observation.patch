+// Pure observation predicate: never changes completion selection or editor state.
+pub(crate) fn selected_row_is_laid_out(
+    active: bool,
+    current_request: bool,
+    selected: usize,
+    row: usize,
+    width: f64,
+    height: f64,
+) -> bool {
+    active
+        && current_request
+        && selected == row
+        && width.is_finite()
+        && height.is_finite()
+        && width > 0.0
+        && height > 0.0
+}
+
+#[cfg(test)]
+mod completion_observation_tests {
+    use super::selected_row_is_laid_out;
+
+    #[test]
+    fn response_without_layout_is_not_ready() {
+        assert!(!selected_row_is_laid_out(true, true, 0, 0, 0.0, 20.0));
+        assert!(!selected_row_is_laid_out(true, true, 0, 0, 200.0, 0.0));
+    }
+
+    #[test]
+    fn inactive_stale_or_unselected_rows_are_not_ready() {
+        assert!(!selected_row_is_laid_out(false, true, 0, 0, 200.0, 20.0));
+        assert!(!selected_row_is_laid_out(true, false, 0, 0, 200.0, 20.0));
+        assert!(!selected_row_is_laid_out(true, true, 1, 0, 200.0, 20.0));
+    }
+
+    #[test]
+    fn invalid_dimensions_are_not_ready() {
+        for dimension in [f64::NAN, f64::INFINITY, -1.0] {
+            assert!(!selected_row_is_laid_out(true, true, 0, 0, dimension, 20.0));
+            assert!(!selected_row_is_laid_out(
+                true, true, 0, 0, 200.0, dimension
+            ));
+        }
+    }
+
+    #[test]
+    fn only_current_selected_laid_out_row_is_ready() {
+        assert!(selected_row_is_laid_out(true, true, 0, 0, 200.0, 20.0));
+        assert!(selected_row_is_laid_out(true, true, 3, 3, 200.0, 20.0));
+    }
+}
