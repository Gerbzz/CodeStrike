+#[cfg(test)]
+mod codestrike_save_tests {
+    use super::*;
+
+    fn fixture() -> (PathBuf, PathBuf) {
+        static FIXTURE_ID: AtomicU64 = AtomicU64::new(0);
+        let dir = std::env::temp_dir().join(format!(
+            "codestrike-save-test-{}-{}",
+            std::process::id(),
+            FIXTURE_ID.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::create_dir(&dir).unwrap();
+        let path = dir.join("main.rs");
+        fs::write(&path, "original\n").unwrap();
+        (dir, path)
+    }
+
+    #[test]
+    fn saves_and_reopens_without_a_leftover_backup() {
+        let (dir, path) = fixture();
+        let mut buffer = Buffer::new(BufferId::next(), path.clone());
+        buffer.rope = Rope::from("edited\n");
+        buffer.save(buffer.rev, false).unwrap();
+        assert_eq!(fs::read_to_string(&path).unwrap(), "edited\n");
+        assert_eq!(
+            Buffer::new(BufferId::next(), path).rope.to_string(),
+            "edited\n"
+        );
+        assert!(!dir.join("main.rsbak").exists());
+        fs::remove_dir_all(dir).unwrap();
+    }
+
+    #[test]
+    fn refuses_to_overwrite_an_external_change() {
+        let (dir, path) = fixture();
+        let mut buffer = Buffer::new(BufferId::next(), path.clone());
+        buffer.rope = Rope::from("our edit\n");
+        fs::write(&path, "external edit\n").unwrap();
+        assert!(buffer.save(buffer.rev, false).is_err());
+        assert_eq!(fs::read_to_string(&path).unwrap(), "external edit\n");
+        fs::remove_dir_all(dir).unwrap();
+    }
+
+    #[test]
+    fn refuses_to_replace_an_existing_backup() {
+        let (dir, path) = fixture();
+        let mut buffer = Buffer::new(BufferId::next(), path.clone());
+        buffer.rope = Rope::from("our edit\n");
+        let backup = dir.join("main.rsbak");
+        fs::write(&backup, "keep this backup\n").unwrap();
+        assert!(buffer.save(buffer.rev, false).is_err());
+        assert_eq!(fs::read_to_string(&path).unwrap(), "original\n");
+        assert_eq!(fs::read_to_string(&backup).unwrap(), "keep this backup\n");
+        fs::remove_dir_all(dir).unwrap();
+    }
+}
