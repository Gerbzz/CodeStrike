+        let generation = self.preview_generation.get_untracked() + 1;
+        self.preview_generation.set(generation);
+        let search = self.clone();
+        let send = create_ext_action(
+            self.common.scope,
+            move |result: Result<ReplacePreview, String>| {
+                if search.preview_generation.get_untracked() != generation {
+                    return;
+                }
+                match result {
+                    Ok(plan) => {
+                        search.replace_status.set(format!(
+                        "Preview: {} matches in {} files; skipped {} unsupported, {} read-only, {} large.",
+                        plan.match_count(),
+                        plan.files.len(),
+                        plan.skipped_unsupported,
+                        plan.skipped_read_only,
+                        plan.skipped_large,
+                    ));
+                        search.replace_preview.set(Some(Arc::new(plan)));
+                    }
+                    Err(err) => {
+                        search.replace_status.set(format!("Preview refused: {err}"))
+                    }
+                }
+            },
+        );
+        thread::spawn(move || {
+            send(
+                codestrike_replace::preview(&root, &query)
+                    .map_err(|err| err.to_string()),
+            )
+        });
+    }
+
+    fn has_dirty_open_files(&self, paths: impl Iterator<Item = PathBuf>) -> bool {
+        let paths: Vec<_> = paths.collect();
+        self.main_split.docs.with_untracked(|docs| {
+            paths
+                .iter()
+                .any(|path| docs.get(path).is_some_and(|doc| !doc.is_pristine()))
+        })
+    }
+
+    pub fn apply_workspace_replace(&self) {
+        if self.applied_replace.get_untracked().is_some() {
+            self.replace_status.set(
+                "Undo the previous workspace replacement before applying another."
+                    .into(),
+            );
+            return;
+        }
+        let Some(plan) = self.replace_preview.get_untracked() else {
+            self.replace_status
+                .set("Preview changes before applying.".into());
+            return;
+        };
+        if self.has_dirty_open_files(plan.files.iter().map(|file| file.path.clone()))
+        {
+            self.replace_status
+                .set("Save or close matching dirty buffers before applying.".into());
+            return;
+        }
+        let report = codestrike_replace::apply(&plan);
+        let count = report.applied.len();
+        if count > 0 {
+            self.applied_replace
+                .set(Some((plan.root.clone(), report.applied)));
+        }
+        self.replace_preview.set(None);
+        self.refresh_generation
+            .update(|generation| *generation += 1);
+        self.replace_status.set(match report.error {
+            Some(err) => format!("Apply stopped: {err}"),
+            None => format!(
+                "Applied {} matches in {count} files. Checked Undo is available.",
+                plan.match_count()
+            ),
+        });
+    }
+
+    pub fn undo_workspace_replace(&self) {
+        let Some((root, files)) = self.applied_replace.get_untracked() else {
+            self.replace_status
+                .set("No replacement to undo in this session.".into());
+            return;
+        };
+        if self.has_dirty_open_files(files.iter().map(|item| item.file.path.clone()))
+        {
+            self.replace_status
+                .set("Save or close matching dirty buffers before Undo.".into());
+            return;
+        }
+        let count = files.len();
+        let report = codestrike_replace::undo(&root, files);
+        self.applied_replace.set(if report.applied.is_empty() {
+            None
+        } else {
+            Some((root, report.applied))
+        });
+        self.refresh_generation
+            .update(|generation| *generation += 1);
+        self.replace_status.set(match report.error {
+            Some(err) => err,
+            None => format!(
+                "Undo restored {count} files after checking their current bytes."
+            ),
+        });
+    }
+
