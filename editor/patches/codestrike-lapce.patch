+fn codestrike_start(window_tab_data: Rc<WindowTabData>) -> impl View {
+    let config = window_tab_data.common.config;
+    let workbench_command = window_tab_data.common.workbench_command;
+    let editor_tabs = window_tab_data.main_split.editor_tabs;
+    let no_workspace = window_tab_data.workspace.path.is_none();
+
+    container(
+        stack((
+            img(|| {
+                include_bytes!("../../../../assets/branding/CodeStrike.png").to_vec()
+            })
+            .style(|s| s.size(112.0, 112.0)),
+            label(|| "CodeStrike".to_string()).style(move |s| {
+                s.font_size(28.0)
+                    .font_bold()
+                    .margin_top(20.0)
+                    .color(config.get().color(LapceColor::EDITOR_FOREGROUND))
+            }),
+            label(|| "Open a project or file to start editing".to_string()).style(
+                move |s| {
+                    s.margin_top(12.0)
+                        .color(config.get().color(LapceColor::EDITOR_DIM))
+                },
+            ),
+            stack((
+                label(|| "Open folder".to_string())
+                    .on_click_stop(move |_| {
+                        workbench_command.send(LapceWorkbenchCommand::OpenFolder);
+                    })
+                    .style(move |s| {
+                        let config = config.get();
+                        s.padding_vert(10.0)
+                            .padding_horiz(18.0)
+                            .border_radius(6.0)
+                            .background(
+                                config.color(
+                                    LapceColor::LAPCE_BUTTON_PRIMARY_BACKGROUND,
+                                ),
+                            )
+                            .color(
+                                config.color(
+                                    LapceColor::LAPCE_BUTTON_PRIMARY_FOREGROUND,
+                                ),
+                            )
+                            .cursor(CursorStyle::Pointer)
+                    }),
+                label(|| "Open file".to_string())
+                    .on_click_stop(move |_| {
+                        workbench_command.send(LapceWorkbenchCommand::OpenFile);
+                    })
+                    .style(move |s| {
+                        let config = config.get();
+                        s.padding_vert(10.0)
+                            .padding_horiz(18.0)
+                            .margin_left(10.0)
+                            .border(1.0)
+                            .border_radius(6.0)
+                            .border_color(config.color(LapceColor::LAPCE_BORDER))
+                            .cursor(CursorStyle::Pointer)
+                    }),
+            ))
+            .style(|s| s.margin_top(28.0)),
+        ))
+        .style(|s| s.flex_col().items_center()),
+    )
+    .style(move |s| {
+        let config = config.get();
+        let is_empty = editor_tabs.with(|tabs| {
+            tabs.values()
+                .all(|tab| tab.with(|tab| tab.children.is_empty()))
+        });
+        s.position(Position::Absolute)
+            .size_full()
+            .flex_col()
+            .items_center()
+            .justify_center()
+            .background(config.color(LapceColor::EDITOR_BACKGROUND))
+            .apply_if(!no_workspace || !is_empty, |s| s.display(Display::None))
+    })
+    .debug_name("CodeStrike Start")
+}
