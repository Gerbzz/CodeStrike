+        fs::write(&path, original).unwrap();
+        let mut buffer = Buffer::new(BufferId::next(), path.clone());
+        assert!(!buffer.read_only);
+        assert_eq!(buffer.rope.to_string(), "\u{feff}let café = 1;\r\n");
+        buffer.rope = Rope::from("\u{feff}let café = 2;\r\n");
+        buffer.save(buffer.rev, false).unwrap();
+        assert_eq!(
+            fs::read(&path).unwrap(),
+            b"\xef\xbb\xbflet caf\xc3\xa9 = 2;\r\n"
+        );
+        assert_eq!(
+            Buffer::new(BufferId::next(), path).rope.to_string(),
+            "\u{feff}let café = 2;\r\n"
+        );
+        fs::remove_dir_all(dir).unwrap();
+    }
