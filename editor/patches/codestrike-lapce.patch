+    fn rejects_unsupported_encodings_and_binary_without_writing() {
+        let (dir, path) = fixture();
+        for (bytes, reason) in [
+            (b"caf\xe9\n".as_slice(), "UTF-8"),
+            (b"\xff\xfeA\0".as_slice(), "UTF-16"),
+            (b"abc\0def".as_slice(), "NUL"),
+        ] {
+            fs::write(&path, bytes).unwrap();
+            let mut buffer = Buffer::new(BufferId::next(), path.clone());
+            assert!(buffer.read_only);
+            assert!(buffer.rope.to_string().contains(reason));
+            buffer.rope = Rope::from("attempted overwrite");
+            assert!(buffer.save(buffer.rev, false).is_err());
+            assert_eq!(fs::read(&path).unwrap(), bytes);
+        }
+        fs::remove_dir_all(dir).unwrap();
+    }
