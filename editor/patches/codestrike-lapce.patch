+    fn saves_and_reopens_without_a_leftover_backup() {
+        let (dir, path) = fixture();
+        let mut buffer = Buffer::new(BufferId::next(), path.clone());
+        buffer.rope = Rope::from("edited\n");
+        buffer.save(buffer.rev, false).unwrap();
+        assert_eq!(fs::read_to_string(&path).unwrap(), "edited\n");
+        assert_eq!(
+            Buffer::new(BufferId::next(), path).rope.to_string(),
+            "edited\n"
+        );
+        assert!(!dir.join("main.rs.bak").exists());
+        fs::remove_dir_all(dir).unwrap();
+    }
