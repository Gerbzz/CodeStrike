+
+    #[test]
+    fn refuses_to_replace_an_existing_backup() {
+        let (dir, path) = fixture();
+        let mut buffer = Buffer::new(BufferId::next(), path.clone());
+        buffer.rope = Rope::from("our edit\n");
+        let backup = dir.join("main.rs.bak");
+        fs::write(&backup, "keep this backup\n").unwrap();
+        assert!(buffer.save(buffer.rev, false).is_err());
+        assert_eq!(fs::read_to_string(&path).unwrap(), "original\n");
+        assert_eq!(fs::read_to_string(&backup).unwrap(), "keep this backup\n");
+        fs::remove_dir_all(dir).unwrap();
+    }
