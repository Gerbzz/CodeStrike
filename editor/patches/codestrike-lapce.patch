+                .set("Open a folder before replacing.".into());
+            return;
+        };
+        let query = ReplaceQuery {
+            pattern: self
+                .editor
+                .doc()
+                .buffer
+                .with_untracked(|buffer| buffer.to_string()),
+            replacement: self
