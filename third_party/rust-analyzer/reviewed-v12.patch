+                    ..Default::default()
+                }),
+                ..Default::default()
+            },
+        };
+        assert!(flycheck_fix_matches_source(&docs, &source, &fix));
+        docs.get_mut(&b_path).unwrap().data = b"unsaved edit".to_vec();
+        assert!(!flycheck_fix_matches_source(&docs, &source, &fix));
+    }
+}
