+fn flycheck_fix_matches_source(current: &MemDocs, source: &MemDocs, fix: &Fix) -> bool {
+    let Some(edit) = fix.action.edit.as_ref() else { return true };
+    if edit.document_changes.is_some() {
+        return false;
+    }
+    edit.changes.as_ref().is_none_or(|changes| {
+        changes.keys().all(|uri| {
+            from_proto::vfs_path(uri)
+                .is_ok_and(|path| current.matches_flycheck_source(source, &path))
+        })
+    })
+}
