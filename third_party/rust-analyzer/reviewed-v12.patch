+        let mut docs = MemDocs::default();
+        docs.insert(a_path, DocumentData::new(1, b"diagnostic".to_vec())).unwrap();
+        docs.insert(b_path.clone(), DocumentData::new(1, b"saved".to_vec())).unwrap();
+        let source = docs.clone();
+        let mut changes = FxHashMap::default();
+        changes.insert(a, Vec::new());
+        changes.insert(b, Vec::new());
