+    /// Has a completed result with no newer operation waiting or running?
+    ///
+    /// A previous result remains available during reloads, so checking only
+    /// `last_op_result` can expose stale build data or proc macros.
+    pub(crate) fn completed_and_idle(&self) -> bool {
+        self.last_op_result.is_some() && !self.op_requested() && !self.op_in_progress()
+    }
+
     // Has an operation been requested?
     pub(crate) fn op_requested(&self) -> bool {
