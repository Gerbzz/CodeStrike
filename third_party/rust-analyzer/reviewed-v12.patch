+#[derive(Debug)]
+pub(crate) struct SerializedDiagnostics {
+    file_id: FileId,
+    sequence: u64,
+    document: Option<Arc<DocumentData>>,
+    uri: Uri,
+    message: lsp_server::Message,
+}
+
+#[derive(Default)]
+struct SentDiagnostics {
+    latest: FxHashMap<FileId, u64>,
+}
+
+impl SentDiagnostics {
+    fn accept(&mut self, file_id: FileId, sequence: u64) -> bool {
+        match self.latest.entry(file_id) {
+            std::collections::hash_map::Entry::Occupied(mut entry) => {
+                if sequence <= *entry.get() {
+                    return false;
+                }
+                entry.insert(sequence);
+            }
+            std::collections::hash_map::Entry::Vacant(entry) => {
+                entry.insert(sequence);
+            }
+        }
+        true
+    }
+}
+
+#[derive(Default)]
+struct PublishedDiagnostics {
+    files: FxHashMap<FileId, (Option<Arc<DocumentData>>, Vec<lsp_types::Diagnostic>)>,
+}
+
+impl PublishedDiagnostics {
+    fn record(
+        &mut self,
+        file_id: FileId,
+        document: Option<&Arc<DocumentData>>,
+        diagnostics: &[lsp_types::Diagnostic],
+    ) -> bool {
+        if let Some((old_document, old_diagnostics)) = self.files.get(&file_id) {
+            let same_document = match (old_document.as_ref(), document) {
+                (Some(old), Some(current)) => Arc::ptr_eq(old, current),
+                (None, None) => true,
+                _ => false,
+            };
+            if same_document && old_diagnostics == diagnostics {
+                return false;
+            }
+        }
+        self.files.insert(file_id, (document.cloned(), diagnostics.to_vec()));
+        true
+    }
+}
+
+#[cfg(test)]
+mod ordered_diagnostics_tests {
+    use super::{PublishedDiagnostics, SentDiagnostics};
+    use crate::mem_docs::DocumentData;
+    use ide::FileId;
+    use triomphe::Arc;
+
+    #[test]
+    fn delayed_older_bundle_must_not_block_or_displace_newer_bundle() {
+        let first = FileId::from_raw(0);
+        let second = FileId::from_raw(1);
+        let mut sent = SentDiagnostics::default();
+        assert!(sent.accept(first, 2));
+        assert!(sent.accept(second, 3));
+        assert!(!sent.accept(first, 1));
+        assert!(sent.accept(first, 4));
+        assert_eq!(sent.latest.len(), 2);
+    }
+
+    #[test]
+    fn missing_completion_does_not_buffer_later_revisions() {
+        let first = FileId::from_raw(0);
+        let second = FileId::from_raw(1);
+        let mut sent = SentDiagnostics::default();
+        assert!(sent.accept(first, 100));
+        assert!(sent.accept(second, 101));
+        assert!(!sent.accept(first, 99));
+        assert_eq!(sent.latest.len(), 2);
+    }
+
+    #[test]
+    fn unchanged_document_and_payload_publish_once() {
+        let first = FileId::from_raw(0);
+        let second = FileId::from_raw(1);
+        let old = Arc::new(DocumentData::new(1, Vec::new()));
+        let current = Arc::new(DocumentData::new(2, Vec::new()));
+        let empty = Vec::new();
+        let error = vec![lsp_types::Diagnostic {
+            message: "error".to_owned().into(),
+            ..Default::default()
+        }];
+        let mut published = PublishedDiagnostics::default();
+        assert!(published.record(first, Some(&old), &empty));
+        assert!(!published.record(first, Some(&old), &empty));
+        assert!(published.record(first, Some(&old), &error));
+        assert!(!published.record(first, Some(&old), &error));
+        assert!(published.record(first, Some(&current), &error));
+        assert!(published.record(second, Some(&old), &error));
+        assert!(!published.record(second, Some(&old), &error));
+    }
+}
