+// A semantic diagnostic snapshot must not use a stale result while a replacement
+// operation is waiting to start or still running.
+#[cfg(test)]
+mod tests {
+    use super::OpQueue;
+
+    #[test]
+    fn completed_and_idle_tracks_first_load_and_reloads() {
+        let mut queue = OpQueue::<(), bool>::default();
+        assert!(!queue.completed_and_idle());
+
+        queue.request_op("initial".to_owned(), ());
+        assert!(!queue.completed_and_idle());
+        assert_eq!(queue.should_start_op(), Some(("initial".to_owned(), ())));
+        assert!(!queue.completed_and_idle());
+
+        queue.op_completed(true);
+        assert!(queue.completed_and_idle());
+
+        queue.request_op("reload".to_owned(), ());
+        assert!(!queue.completed_and_idle(), "old result must not count while reload is queued");
+        assert_eq!(queue.should_start_op(), Some(("reload".to_owned(), ())));
+        assert!(!queue.completed_and_idle(), "old result must not count while reload runs");
+
+        queue.request_op("newer reload".to_owned(), ());
+        queue.op_completed(false);
+        assert!(!queue.completed_and_idle(), "a queued replacement still blocks readiness");
+        assert_eq!(queue.should_start_op(), Some(("newer reload".to_owned(), ())));
+        assert!(!queue.completed_and_idle());
+        queue.op_completed(false);
+        assert!(queue.completed_and_idle(), "completion is independent of the output value");
+    }
+}
